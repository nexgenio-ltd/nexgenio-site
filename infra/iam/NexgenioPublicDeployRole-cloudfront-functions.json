{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ManageTheSingleViewerRequestFunction",
      "Effect": "Allow",
      "Action": [
        "cloudfront:UpdateFunction",
        "cloudfront:DescribeFunction",
        "cloudfront:GetFunction",
        "cloudfront:PublishFunction",
        "cloudfront:TestFunction"
      ],
      "Resource": "arn:aws:cloudfront::124971231536:function/nexgenio-directory-index"
    },
    {
      "Sid": "ReadTheDistributionToConfirmTheAssociation",
      "Effect": "Allow",
      "Action": [
        "cloudfront:GetDistribution",
        "cloudfront:GetDistributionConfig"
      ],
      "Resource": "arn:aws:cloudfront::124971231536:distribution/E2WWYNB9MTIF3N"
    }
  ]
}
